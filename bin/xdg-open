#!/bin/bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
for arg in "$@"; do
    case "$arg" in
        http*)
            echo "$arg" > "$SCRIPT_DIR/auth_url.txt"
            if command -v powershell.exe >/dev/null 2>&1; then
                powershell.exe -NoProfile -Command "Start-Process '$arg'" < /dev/null > /dev/null 2>&1 &
            fi
            ;;
    esac
done
exit 0
